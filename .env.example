# WhatsApp number used by every WhatsApp CTA on the site.
# International format: country code + number, NO "+", NO leading 0, NO spaces.
# Example for 0812-3456-7890  ->  6281234567890
# TODO(launch): set the real J&B Rooms WhatsApp number (required before launch).
NEXT_PUBLIC_WHATSAPP_NUMBER=62XXXXXXXXXX

# Optional: override how the number is displayed (otherwise it is formatted automatically).
# NEXT_PUBLIC_WHATSAPP_DISPLAY=+62 812-3456-7890

# Canonical production URL (used for sitemap, canonical links, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.jbrooms.co.id

# Optional: Google Analytics 4 measurement ID. Vercel Analytics is always on.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
