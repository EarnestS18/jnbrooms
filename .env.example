# WhatsApp numbers. Both have real defaults in config/contact.ts, so these are OPTIONAL overrides.
# International format: country code + number, NO "+", NO leading 0, NO spaces.
# Primary contact (used by every WhatsApp CTA) — default: Yenny Kristina, 628159495520
# NEXT_PUBLIC_WHATSAPP_NUMBER=628159495520
# Second contact shown on /contact and in the footer — default: Aidil Putra, 6289620500333
# NEXT_PUBLIC_WHATSAPP_NUMBER_2=6289620500333

# Canonical production URL (used for sitemap, canonical links, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.jbrooms.co.id

# Optional: Google Analytics 4 measurement ID. Vercel Analytics is always on.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
